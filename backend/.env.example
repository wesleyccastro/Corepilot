# Postgres connection string used by Prisma. Use the Supabase "Session pooler"
# connection string (port 5432) for local dev on IPv4 networks — the direct
# db.<project>.supabase.co host is IPv6-only unless the IPv4 add-on is enabled.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Public project URL, used to build the JWKS endpoint for JWT verification
# (https://<project>.supabase.co/auth/v1/.well-known/jwks.json).
SUPABASE_URL=https://your-project.supabase.co

# Secret API key (or legacy service_role key). Used only by the seed script to
# create users via the Supabase Admin API. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Public (non-secret) API key. Used only by test/seed helpers to sign in a real
# test user via the Supabase anon-level auth API and obtain a JWT access token.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Password for the seed accounts (seed-a@corepilot.dev / seed-b@corepilot.dev).
# Required by `npm run db:seed` — the script fails fast if it is unset, and
# never falls back to a default. These are real, email-confirmed accounts on
# the Supabase project, so pick a random value and keep it out of git. Re-running
# the seed resets the existing accounts' passwords to whatever is set here.
SEED_USER_PASSWORD=change-me

# Optional. Origin allowed by the API's CORS policy (src/main.ts).
# Defaults to http://localhost:5173 (the Vite dev server) when unset.
# FRONTEND_ORIGIN=http://localhost:5173

# Optional. Port the NestJS API listens on (src/main.ts). Defaults to 3000.
# Must match the frontend's VITE_API_BASE_URL.
# PORT=3000
